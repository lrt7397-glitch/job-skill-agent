# ============================================================
# 环境变量模板：复制为 .env 后填入 LLM_API_KEY 即可运行
#   Windows:     Copy-Item .env.example .env
#   macOS/Linux: cp .env.example .env
# 注意：.env 内含密钥，不要提交到 Git
# ============================================================

# ---------- LLM 配置（必填）----------
# 填入你的 DeepSeek / OpenAI / 通义 / Ollama API Key
LLM_API_KEY=

# ---------- LLM 配置（选填，留空使用默认值）----------
# 服务提供方：deepseek / openai / ollama / qwen ...
LLM_PROVIDER=deepseek
# 模型 ID
LLM_MODEL_ID=deepseek-chat
# API 基础 URL（OpenAI 兼容服务地址）
LLM_API_BASE=https://api.deepseek.com/v1
# 采样温度
LLM_TEMPERATURE=0.3

# ---------- 爬虫配置（选填，留空使用默认值）----------
# 搜索关键词
SCRAPER_QUERY=Python
# 城市代码（101020100=上海，101010100=北京，101280100=广州，101280600=深圳）
SCRAPER_CITY=101020100
# 薪资代码（405=10-20K，406=20-30K，404=8-12K）
SCRAPER_SALARY=405
# 学历代码（203=本科，204=硕士，202=大专）
SCRAPER_DEGREE=203
# 经验代码（空=不限，104=3-5年，105=5-10年）
SCRAPER_EXPERIENCE=
# 最大采集页数
SCRAPER_MAX_PAGES=3
# 每页条数
SCRAPER_PAGE_SIZE=30
# 是否无头模式（首次登录必须为 False，否则看不到登录窗口）
SCRAPER_HEADLESS=False
# 浏览器用户数据目录（持久化登录态，体积较大，不要提交到 Git）
SCRAPER_USER_DATA_DIR=./boss_profile
# 首次手动登录等待秒数（网速慢可调到 60）
SCRAPER_LOGIN_WAIT=20
# 翻页间隔秒数（建议不低于 2.0）
SCRAPER_PAGE_DELAY=2.0

# ---------- 应用配置（选填）----------
# 结果输出路径
OUTPUT_PATH=data/results.json
